{
  "name": "rackdoll",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Faithful replication of Ragdoll Volleyball (Sedoiga, 2009) on planck.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "planck": "^1.4.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
